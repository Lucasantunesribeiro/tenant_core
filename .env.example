# Valores APENAS para desenvolvimento local com docker compose.
# Troque todos antes de expor a stack em qualquer rede.

# Senha do usuário sa do container SQL Server (precisa cumprir a política de complexidade do SQL Server).
MSSQL_SA_PASSWORD=Your_password123

# Chave HMAC do JWT (mínimo 32 caracteres). Gere uma com: openssl rand -base64 48
JWT_SIGNING_KEY=tenant-core-development-signing-key-please-change

# URL base da API usada no build do frontend (sem barra final).
VITE_API_URL=http://localhost:5000
